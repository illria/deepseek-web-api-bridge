STATE_ENCRYPTION_KEY=
ALLOW_PLAINTEXT_STATE=false

ACCOUNTS_DIR=data/accounts
JOBS_DIR=data/jobs
RUNTIME_SETTINGS_FILE=data/settings/runtime.json

BRIDGE_API_KEYS=sk-local-change-me

BROWSER_HEADLESS=true
BROWSER_NO_SANDBOX=true
BROWSER_TIMEOUT_MS=45000

DEFAULT_ASK_TIMEOUT_MS=120000
MAX_PROMPT_CHARS=60000
NEW_CONVERSATION_PER_REQUEST=false
AUTO_START_WORKER=true
WORKER_RECOVERY_RETRIES=1
WORKER_HEALTHCHECK_SECONDS=20
WORKER_HARD_TIMEOUT_MS=150000
MAX_CONSECUTIVE_FAILURES_BEFORE_RESTART=2
CONTEXT_AUTO_RESET_ENABLED=true
CONTEXT_FULL_RETRY_ONCE=true
MAX_QUEUE_SIZE=500

UPLOAD_DIR=data/uploads
DATASET_META_DIR=data/datasets
MAX_UPLOAD_MB=100
MAX_RESULT_ROWS=200

HOST=0.0.0.0
PORT=8000
